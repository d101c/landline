#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# landline-setup : les réglages Bluetooth dont le moteur d'Landline
# a besoin. Managed by landline-setup.
#
#   landline-setup status              état courant et persistance, une ligne JSON
#   landline-setup apply  [--dry-run]  règle tout, maintenant et pour les redémarrages
#   landline-setup revert [--dry-run]  retire tout ce que « apply » a créé
#   landline-setup version             numéro de version de l'assistant
#
# Les deux réglages exigés :
#   experimental  bluetoothd lancé avec --experimental (lien double BR/EDR + LE).
#                 Non requis à partir de BlueZ 5.88, où l'API Bearer est stable.
#   ertm          ERTM L2CAP actif (disable_ertm = N), nécessaire à MAP et PBAP
#
# Le réglage souhaité, jamais bloquant (« ready » n'en dépend pas) :
#   le_params     l'auxiliaire landline-le-params, copié appartenant à root
#                 dans /usr/local/libexec/landline/ avec le seul droit
#                 cap_net_raw (setcap cap_net_raw+ep). Le moteur s'en sert pour
#                 demander à l'iPhone une supervision de 6 s sur le lien LE
#                 (commande HCI LE Connection Update). Sa source est cherchée
#                 uniquement à côté de l'assistant en cours (voir
#                 le_params_source), jamais dans le dossier personnel de
#                 l'utilisateur qui a lancé pkexec ou sudo. Introuvable, ou
#                 setcap absent : « apply » le dit, laisse ce réglage de côté
#                 et réussit quand même.
#
# La classe d'appareil (device_class) n'est plus exigée : l'iPhone propose
# messages, contacts et notifications avec la classe d'origine de l'ordinateur.
# « status » la publie pour information ; « apply » ne la pose plus et retire
# l'unité, la règle udev et l'auxiliaire qu'une version précédente avait posés.
#
# Les premières installations portaient le nom « iphone-link ». « apply » et
# « revert » reconnaissent ce qu'elles ont laissé (unités, fichier d'appoint,
# copie de l'assistant, fiche polkit) et le retirent ; « status » en tient
# compte tant que c'est encore en place.
#
# « apply » et « revert » demandent les droits administrateur, sauf avec
# --dry-run, qui affiche ce qui serait écrit et exécuté sans rien faire.
#
# Variable LANDLINE_ROOT (essais) : racine factice. Toutes les lectures et
# écritures s'y font, les droits administrateur ne sont plus exigés, et aucune
# commande système n'est lancée : seules les doublures exécutables placées dans
# $LANDLINE_ROOT/.stubs/<commande> le sont ; les commandes demandées sont
# consignées dans $LANDLINE_ROOT/.commands.log.
#
# Codes de sortie : 0 réussi ; 1 droits manquants ou erreur ; 2 réglages écrits
# mais une étape d'activation a échoué ; 64 mauvais usage.
set -euo pipefail

VERSION=4
# Le nom court : tout ce que l'assistant écrit sur le système en dérive.
NAME=landline
# Le nom des premières installations.
OLD_NAME=iphone-link
# En-tête des fichiers écrits ; un fichier qui ne le porte pas n'est jamais retiré.
MARKER="Managed by $NAME-setup"
OLD_MARKER="géré par $OLD_NAME"

ROOT="${LANDLINE_ROOT:-}"
ROOT="${ROOT%/}"
DRY=0
WARNINGS=0
CHANGED=0

if [ -z "$ROOT" ]; then
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export PATH
fi

# Chemins « logiques » : toujours préfixés par $ROOT à l'accès.
SYSTEMD_DIR=/etc/systemd/system
DROPIN_DIR=$SYSTEMD_DIR/bluetooth.service.d
DROPIN=$DROPIN_DIR/$NAME-experimental.conf
UNIT_ERTM_NAME=$NAME-ertm.service
UNIT_ERTM=$SYSTEMD_DIR/$UNIT_ERTM_NAME
WANTS_ERTM=$SYSTEMD_DIR/multi-user.target.wants/$UNIT_ERTM_NAME
LIBEXEC_PARENT=/usr/local/libexec
LIBEXEC=$LIBEXEC_PARENT/$NAME
SELF_INSTALLED=$LIBEXEC/$NAME-setup
PARENT_MARK=$LIBEXEC/.parent-created
LE_HELPER_NAME=$NAME-le-params
LE_HELPER=$LIBEXEC/$LE_HELPER_NAME
# Noté par apply à côté de l'auxiliaire (un binaire ne porte pas d'en-tête) :
# revert ne retire l'auxiliaire que s'il le trouve.
LE_HELPER_MARK=$LIBEXEC/$LE_HELPER_NAME.managed
# Taille au-delà de laquelle une source n'est pas prise pour l'auxiliaire.
LE_HELPER_MAX_BYTES=8388608
POLICY_ID=io.github.d101c.$NAME
POLICY=/usr/share/polkit-1/actions/$POLICY_ID.policy

# Ce qu'une installation sous l'ancien nom a pu laisser. La classe d'appareil
# n'a existé que sous ce nom.
OLD_DROPIN=$DROPIN_DIR/$OLD_NAME-experimental.conf
OLD_UNIT_ERTM_NAME=$OLD_NAME-ertm.service
OLD_UNIT_ERTM=$SYSTEMD_DIR/$OLD_UNIT_ERTM_NAME
OLD_WANTS_ERTM=$SYSTEMD_DIR/multi-user.target.wants/$OLD_UNIT_ERTM_NAME
UNIT_CLASS_NAME=$OLD_NAME-btclass.service
UNIT_CLASS=$SYSTEMD_DIR/$UNIT_CLASS_NAME
WANTS_CLASS=$SYSTEMD_DIR/bluetooth.service.wants/$UNIT_CLASS_NAME
UDEV_RULE=/etc/udev/rules.d/$OLD_NAME-btclass.rules
OLD_LIBEXEC=$LIBEXEC_PARENT/$OLD_NAME
OLD_SELF=$OLD_LIBEXEC/$OLD_NAME-setup
CLASS_HELPER=$OLD_LIBEXEC/$OLD_NAME-btclass
OLD_PARENT_MARK=$OLD_LIBEXEC/.parent-created
OLD_POLICY=/usr/share/polkit-1/actions/io.github.d101c.$OLD_NAME.policy
# Mis à 1 quand l'ancien fichier d'appoint va être retiré : il ne compte plus.
SKIP_OLD_DROPIN=0
ERTM_PARAM=/sys/module/bluetooth/parameters/disable_ertm

say()  { printf '%s\n' "$*"; }
warn() { printf 'attention : %s\n' "$*" >&2; WARNINGS=$((WARNINGS + 1)); }
# Pour le réglage souhaité : dit, sans faire échouer apply.
note() { printf 'remarque : %s\n' "$*" >&2; }
die()  { printf 'erreur : %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Commandes système
# ---------------------------------------------------------------------------

# Commande de lecture seule. Racine factice : doublure ou échec.
sys_query() {
    if [ -n "$ROOT" ]; then
        local stub="$ROOT/.stubs/$1"
        [ -x "$stub" ] || return 1
        shift
        LANDLINE_ROOT="$ROOT" "$stub" "$@"
    else
        "$@"
    fi
}

# Commande qui modifie le système. --dry-run : affichée seulement.
sys_run() {
    if [ "$DRY" = 1 ]; then
        say "exécuterait : $*"
        return 0
    fi
    say "exécute : $*"
    if [ -n "$ROOT" ]; then
        printf '%s\n' "$*" >> "$ROOT/.commands.log"
        local stub="$ROOT/.stubs/$1"
        [ -x "$stub" ] || return 0
        shift
        LANDLINE_ROOT="$ROOT" "$stub" "$@"
    else
        "$@"
    fi
}

# ---------------------------------------------------------------------------
# Écritures
# ---------------------------------------------------------------------------

# write_file <chemin> <mode> : contenu sur l'entrée standard. Met CHANGED à 1
# si le fichier est créé ou modifié.
write_file() {
    local path="$1" mode="$2" content
    content="$(cat)"
    if [ -f "$ROOT$path" ] && [ "$(cat "$ROOT$path")" = "$content" ]; then
        say "inchangé : $path"
        return 0
    fi
    CHANGED=1
    if [ "$DRY" = 1 ]; then
        say "écrirait : $path (mode $mode)"
        printf '%s\n' "$content" | sed 's/^/    | /'
        return 0
    fi
    mkdir -p "$(dirname "$ROOT$path")"
    printf '%s\n' "$content" > "$ROOT$path.tmp"
    chmod "$mode" "$ROOT$path.tmp"
    mv -f "$ROOT$path.tmp" "$ROOT$path"
    say "écrit : $path"
}

# make_link <cible> <lien> : lien symbolique, comme « systemctl enable ».
make_link() {
    local target="$1" link="$2"
    if [ -L "$ROOT$link" ] && [ "$(readlink "$ROOT$link")" = "$target" ]; then
        say "inchangé : $link"
        return 0
    fi
    CHANGED=1
    if [ "$DRY" = 1 ]; then
        say "créerait le lien : $link -> $target"
        return 0
    fi
    mkdir -p "$(dirname "$ROOT$link")"
    ln -sfn "$target" "$ROOT$link"
    say "lien créé : $link -> $target"
}

# remove_path <chemin> [marque] : retire un fichier ou un lien. Avec « marque »,
# seulement si le fichier porte notre en-tête (ou celui de l'ancien nom).
remove_path() {
    local path="$1" need_mark="${2:-}"
    if [ ! -e "$ROOT$path" ] && [ ! -L "$ROOT$path" ]; then
        return 0
    fi
    if [ -n "$need_mark" ] && ! grep -q -e "$MARKER" -e "$OLD_MARKER" "$ROOT$path" 2>/dev/null; then
        warn "$path ne porte pas l'en-tête de $NAME-setup : laissé en place"
        return 0
    fi
    CHANGED=1
    if [ "$DRY" = 1 ]; then
        say "retirerait : $path"
        return 0
    fi
    rm -f "$ROOT$path"
    say "retiré : $path"
}

# remove_dir_if_empty <chemin>
remove_dir_if_empty() {
    local path="$1"
    [ -d "$ROOT$path" ] || return 0
    if [ "$DRY" = 1 ]; then
        # À blanc, nos fichiers sont encore là : le dossier sera
        # vide s'il ne contient qu'eux.
        local entry
        for entry in "$ROOT$path"/* "$ROOT$path"/.[!.]*; do
            [ -e "$entry" ] || [ -L "$entry" ] || continue
            case "$(basename "$entry")" in
                "$NAME"*|"$OLD_NAME"*|.parent-created) ;;
                *) return 0 ;;
            esac
        done
        say "retirerait le dossier vide : $path"
        return 0
    fi
    if rmdir "$ROOT$path" 2>/dev/null; then
        say "dossier vide retiré : $path"
    fi
}

# write_sysfs <chemin> <valeur>
write_sysfs() {
    local path="$1" value="$2"
    if [ "$DRY" = 1 ]; then
        say "écrirait : $value dans $path"
        return 0
    fi
    if [ ! -e "$ROOT$path" ]; then
        warn "$path absent (module bluetooth non chargé ?)"
        return 0
    fi
    if printf '%s\n' "$value" > "$ROOT$path"; then
        say "écrit : $value dans $path"
    else
        warn "écriture de $value dans $path refusée"
    fi
}

# ---------------------------------------------------------------------------
# Lecture de l'état
# ---------------------------------------------------------------------------

has_experimental_flag() {
    [[ "$1" =~ (^|[[:space:]])(--experimental|-E)([[:space:]]|$) ]]
}

# Ligne ExecStart effective de bluetooth.service, d'après les fichiers d'unité
# et d'appoint, dans l'ordre où systemd les lit. $1 = "sans-nous" : ignore le
# nos fichiers d'appoint (le nôtre et celui de l'ancien nom).
effective_execstart() {
    local skip_ours="${1:-}" dir base="" name result="" line value file
    local -a dirs=(/etc/systemd/system /run/systemd/system /usr/local/lib/systemd/system
                   /usr/lib/systemd/system /lib/systemd/system)
    local -A dropins=()
    local -a files=()

    for dir in "${dirs[@]}"; do
        if [ -z "$base" ] && [ -f "$ROOT$dir/bluetooth.service" ]; then
            base="$ROOT$dir/bluetooth.service"
        fi
        for file in "$ROOT$dir"/bluetooth.service.d/*.conf; do
            [ -f "$file" ] || continue
            name="$(basename "$file")"
            if [ "$skip_ours" = sans-nous ] && [ "$name" = "$(basename "$DROPIN")" ]; then
                continue
            fi
            if [ "$name" = "$(basename "$OLD_DROPIN")" ] &&
               { [ "$skip_ours" = sans-nous ] || [ "$SKIP_OLD_DROPIN" = 1 ]; }; then
                continue
            fi
            # Le premier dossier l'emporte pour un même nom de fichier.
            [ -n "${dropins[$name]:-}" ] || dropins[$name]="$file"
        done
    done

    [ -n "$base" ] && files+=("$base")
    while IFS= read -r name; do
        [ -n "$name" ] && files+=("${dropins[$name]}")
    done < <(printf '%s\n' "${!dropins[@]}" | LC_ALL=C sort)

    for file in "${files[@]}"; do
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ExecStart=*)
                    value="${line#ExecStart=}"
                    # « ExecStart= » vide efface ce qui précède.
                    result="$value"
                    ;;
            esac
        done < "$file"
    done
    printf '%s\n' "$result"
}

main_conf_experimental() {
    grep -Eiq '^[[:space:]]*Experimental[[:space:]]*=[[:space:]]*true[[:space:]]*$' \
        "$ROOT/etc/bluetooth/main.conf" 2>/dev/null
}

persistent_experimental() {
    has_experimental_flag "$(effective_execstart)" || main_conf_experimental
}

# Ligne de commande du bluetoothd en cours, vide s'il ne tourne pas.
running_bluetoothd_cmdline() {
    local pid=""
    pid="$(sys_query systemctl show -p MainPID --value bluetooth.service 2>/dev/null || true)"
    if [ -z "$pid" ] || [ "$pid" = 0 ]; then
        pid="$(sys_query pgrep -o -x bluetoothd 2>/dev/null || true)"
    fi
    if [ -n "$pid" ] && [ "$pid" != 0 ] && [ -r "$ROOT/proc/$pid/cmdline" ]; then
        tr '\0' ' ' < "$ROOT/proc/$pid/cmdline"
    fi
}

current_experimental() {
    local cmdline
    cmdline="$(running_bluetoothd_cmdline)"
    if [ -z "$cmdline" ]; then
        # bluetoothd arrêté : ce qui compte est ce avec quoi il démarrera.
        persistent_experimental
        return
    fi
    has_experimental_flag "$cmdline" || main_conf_experimental
}

# Vrai si un bluetoothd tourne sans le mode expérimental : lui seul oblige à
# redémarrer le service.
running_without_experimental() {
    [ -n "$(running_bluetoothd_cmdline)" ] && ! current_experimental
}

list_adapters() {
    local entry name
    for entry in "$ROOT"/sys/class/bluetooth/hci*; do
        name="$(basename "$entry")"
        [[ "$name" =~ ^hci[0-9]+$ ]] && printf '%s\n' "${name#hci}"
    done
    return 0
}

# « btmgmt info » pour un adaptateur. btmgmt exige une entrée standard
# ouverte (il refuse /dev/null), d'où le tube.
adapter_info() {
    if [ -n "$ROOT" ]; then
        echo | sys_query btmgmt --index "$1" info 2>/dev/null || true
    else
        echo | timeout 5 btmgmt --index "$1" info 2>/dev/null || true
    fi
}

# Secours sans btmgmt : mêmes renseignements par D-Bus, remis dans la forme
# de « btmgmt info ».
adapter_info_dbus() {
    local path="/org/bluez/hci$1" class powered
    class="$(sys_query busctl --system get-property org.bluez "$path" org.bluez.Adapter1 Class 2>/dev/null || true)"
    powered="$(sys_query busctl --system get-property org.bluez "$path" org.bluez.Adapter1 Powered 2>/dev/null || true)"
    [[ "$class" =~ ^u[[:space:]]+([0-9]+)$ ]] || return 0
    printf 'class 0x%06x\n' "${BASH_REMATCH[1]}"
    if [ "$powered" = "b true" ]; then
        printf 'current settings: powered\n'
    fi
}

class_is_handsfree() {
    local hex="$1"
    [[ "$hex" =~ ^[0-9a-fA-F]{6}$ ]] || return 1
    [ $(( 16#$hex & 0x1fff )) -eq $(( 0x0408 )) ]
}

# Vrai si au moins un adaptateur allumé existe et que tous les adaptateurs
# allumés portent la classe 0x..0408. Un adaptateur éteint lit 0x000000 : il
# est ignoré.
current_class() {
    local index info hex powered_count=0
    while IFS= read -r index; do
        [ -n "$index" ] || continue
        info="$(adapter_info "$index")"
        [ -n "$info" ] || info="$(adapter_info_dbus "$index")"
        grep -Eq 'current settings:.*(^|[[:space:]])powered([[:space:]]|$)' <<< "$info" || continue
        powered_count=$((powered_count + 1))
        hex="$(sed -n 's/.*class 0x\([0-9a-fA-F]\{6\}\).*/\1/p' <<< "$info" | head -n 1)"
        class_is_handsfree "$hex" || return 1
    done < <(list_adapters)
    [ "$powered_count" -gt 0 ]
}

persistent_class() {
    if [ -f "$ROOT$UNIT_CLASS" ] && [ -L "$ROOT$WANTS_CLASS" ] && [ -x "$ROOT$CLASS_HELPER" ]; then
        return 0
    fi
    # Unité équivalente de Tether, si elle a été activée à la main.
    local link
    for link in "$ROOT$SYSTEMD_DIR"/bluetooth.service.wants/tether-btclass@*.service; do
        [ -L "$link" ] && return 0
    done
    return 1
}

current_ertm() {
    local value
    # Fichier absent : module non chargé, donc rien de désactivé (même lecture
    # que le moteur).
    [ -r "$ROOT$ERTM_PARAM" ] || return 0
    value="$(head -c 1 "$ROOT$ERTM_PARAM" 2>/dev/null || true)"
    [ "$value" != Y ] && [ "$value" != y ] && [ "$value" != 1 ]
}

# Valeur de disable_ertm que la configuration du système impose au démarrage,
# sans nous : « 1 », « Y », « N »… ou rien si personne ne la fixe.
dictated_ertm() {
    local file line value=""
    local re='^[[:space:]]*/?module/bluetooth/parameters/disable_ertm[[:space:]]*=[[:space:]]*([^[:space:]]+)'
    for file in "$ROOT/etc/sysfs.conf" "$ROOT"/etc/sysfs.d/*.conf; do
        [ -f "$file" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            [[ "$line" =~ $re ]] && value="${BASH_REMATCH[1]}"
        done < "$file"
    done
    if [ -z "$value" ]; then
        re='^[[:space:]]*options[[:space:]]+bluetooth[[:space:]].*disable_ertm=([^[:space:]]+)'
        for file in "$ROOT"/etc/modprobe.d/*.conf "$ROOT"/usr/lib/modprobe.d/*.conf; do
            [ -f "$file" ] || continue
            while IFS= read -r line || [ -n "$line" ]; do
                [[ "$line" =~ $re ]] && value="${BASH_REMATCH[1]}"
            done < "$file"
        done
    fi
    if [ -z "$value" ] && [ -r "$ROOT/proc/cmdline" ]; then
        re='(^|[[:space:]])bluetooth\.disable_ertm=([^[:space:]]+)'
        IFS= read -r line < "$ROOT/proc/cmdline" || true
        [[ "$line" =~ $re ]] && value="${BASH_REMATCH[2]}"
    fi
    printf '%s\n' "$value"
}

persistent_ertm() {
    if [ -f "$ROOT$UNIT_ERTM" ] && [ -L "$ROOT$WANTS_ERTM" ]; then
        return 0
    fi
    # L'unité de l'ancien nom fait le même travail tant qu'elle est là.
    if [ -f "$ROOT$OLD_UNIT_ERTM" ] && [ -L "$ROOT$OLD_WANTS_ERTM" ]; then
        return 0
    fi
    case "$(dictated_ertm)" in
        1|Y|y) return 1 ;;
        *)     return 0 ;;
    esac
}

# Version de BlueZ installée, « 5.87 », ou rien si elle ne se lit pas.
# Lue auprès des programmes eux-mêmes, jamais supposée.
bluez_version() {
    local out="" bin
    out="$(sys_query bluetoothctl --version 2>/dev/null || true)"
    if ! [[ "$out" =~ ([0-9]+)\.([0-9]+) ]]; then
        if [ -n "$ROOT" ]; then
            out="$(sys_query bluetoothd --version 2>/dev/null || true)"
        else
            bin="$(bluetoothd_command 2>/dev/null || true)"
            bin="${bin%% *}"
            if [ -n "$bin" ] && [ -x "$bin" ]; then
                out="$("$bin" --version 2>/dev/null || true)"
            fi
        fi
    fi
    if [[ "$out" =~ ([0-9]+)\.([0-9]+) ]]; then
        printf '%s.%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    fi
}

# version_at_least <version> <majeur> <mineur>
version_at_least() {
    [[ "$1" =~ ^([0-9]+)\.([0-9]+)$ ]] || return 1
    local major=$((10#${BASH_REMATCH[1]})) minor=$((10#${BASH_REMATCH[2]}))
    [ "$major" -gt "$2" ] || { [ "$major" -eq "$2" ] && [ "$minor" -ge "$3" ]; }
}

# L'API Bearer (Bearer.LE1, Bearer.BREDR1), dont dépend le lien double, sort
# du mode expérimental avec BlueZ 5.88. Version illisible : on reste prudent,
# le mode expérimental est exigé.
BEARER_STABLE_MAJOR=5
BEARER_STABLE_MINOR=88
experimental_required() {
    ! version_at_least "$(bluez_version)" "$BEARER_STABLE_MAJOR" "$BEARER_STABLE_MINOR"
}

# L'auxiliaire des paramètres de connexion LE est en place et peut servir :
# fichier ordinaire exécutable, à root, que personne d'autre ne peut écrire,
# portant cap_net_raw dans ses ensembles effectif et permis.
le_params_ready() {
    local path="$ROOT$LE_HELPER" caps owner mode
    [ -f "$path" ] && [ ! -L "$path" ] && [ -x "$path" ] || return 1
    if [ -z "$ROOT" ]; then
        owner="$(stat -c %u "$path" 2>/dev/null || true)"
        [ "$owner" = 0 ] || return 1
    fi
    mode="$(stat -c %a "$path" 2>/dev/null || true)"
    [[ "$mode" =~ ^[0-7]*[0-7][0145][0145]$ ]] || return 1
    caps="$(le_params_getcap "$path")"
    [[ "$caps" =~ cap_net_raw([,a-z_]*)?[=+](ep|pe) ]]
}

le_params_getcap() {
    if [ -n "$ROOT" ]; then
        sys_query getcap "$1" 2>/dev/null || true
    else
        "$(tool_path getcap /usr/sbin/getcap)" "$1" 2>/dev/null || true
    fi
}

json_bool() { if "$@"; then printf true; else printf false; fi; }

# « ready » ne dépend que de ce qui est exigé sur cette machine : l'ERTM, et le
# mode expérimental quand BlueZ en a encore besoin. « device_class » n'est
# publié que pour information. « le_params » (l'auxiliaire des paramètres de
# connexion LE) est souhaité : l'extension le propose quand il manque.
status_json() {
    local experimental device_class ertm need_experimental ready=false version
    experimental="$(json_bool current_experimental)"
    device_class="$(json_bool current_class)"
    ertm="$(json_bool current_ertm)"
    need_experimental="$(json_bool experimental_required)"
    version="$(bluez_version)"
    if [ "$ertm" = true ] && { [ "$experimental" = true ] || [ "$need_experimental" = false ]; }; then
        ready=true
    fi
    printf '{"experimental":%s,"device_class":%s,"ertm":%s,"ready":%s,"persistent":{"experimental":%s,"device_class":%s,"ertm":%s},"required":{"experimental":%s,"ertm":true},"bluez_version":"%s","le_params":%s}\n' \
        "$experimental" "$device_class" "$ertm" "$ready" \
        "$(json_bool persistent_experimental)" "$(json_bool persistent_class)" "$(json_bool persistent_ertm)" \
        "$need_experimental" "$version" "$(json_bool le_params_ready)"
}

# ---------------------------------------------------------------------------
# Contenu des fichiers créés
# ---------------------------------------------------------------------------

content_dropin() {
    cat <<EOF
# $MARKER. Do not edit: "$NAME-setup revert" removes this file.
# Starts bluetoothd in experimental mode. Without it there is no Bluetooth LE
# link to the iPhone, so no notifications.
[Service]
ExecStart=
ExecStart=$1 --experimental
EOF
}

content_unit_ertm() {
    cat <<EOF
# $MARKER. Do not edit: "$NAME-setup revert" removes this file.
# Turns L2CAP ERTM back on, which messages (MAP) and contacts (PBAP) need.
# Ordered after sysfsutils: /etc/sysfs.conf is left alone, this unit simply
# writes last.
[Unit]
Description=Landline: keep L2CAP ERTM enabled for Bluetooth
After=sysfsutils.service systemd-modules-load.service
Before=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-$1 -q bluetooth
ExecStart=/bin/sh -c 'echo N > $ERTM_PARAM'

[Install]
WantedBy=multi-user.target
EOF
}

content_policy() {
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- $MARKER. "$NAME-setup revert" removes this file. -->
<policyconfig>
  <vendor>Landline</vendor>
  <vendor_url>https://github.com/d101c/landline</vendor_url>
  <action id="$POLICY_ID.setup">
    <description>Change Bluetooth settings so this computer can link to an iPhone</description>
    <message>Change Bluetooth settings so this computer can link to an iPhone</message>
    <icon_name>bluetooth-active-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">$SELF_INSTALLED</annotate>
  </action>
</policyconfig>
EOF
}

# ---------------------------------------------------------------------------
# Outils d'apply / revert
# ---------------------------------------------------------------------------

require_root() {
    [ "$DRY" = 1 ] && return 0
    [ -n "$ROOT" ] && return 0
    if [ "$(id -u)" -ne 0 ]; then
        printf 'erreur : « %s » demande les droits administrateur.\n' "$1" >&2
        printf 'Relancez avec : pkexec %s %s   (ou sudo)\n' "$(self_path)" "$1" >&2
        printf 'Pour voir ce qui serait fait sans rien changer : %s %s --dry-run\n' "$(self_path)" "$1" >&2
        exit 1
    fi
}

self_path() {
    local src="${BASH_SOURCE[0]}"
    readlink -f "$src" 2>/dev/null || printf '%s\n' "$src"
}

# Chemin absolu d'un outil du système ; à défaut, chemin usuel.
tool_path() {
    local name="$1" fallback="$2" found=""
    if [ -z "$ROOT" ]; then
        found="$(command -v "$name" 2>/dev/null || true)"
    fi
    printf '%s\n' "${found:-$fallback}"
}

# Binaire de bluetoothd (avec ses éventuelles options) tel que l'unité le lance.
bluetoothd_command() {
    local exec_line candidate
    exec_line="$(effective_execstart sans-nous)"
    # Préfixes d'ExecStart de systemd (-, @, :, +, !) : à retirer.
    while [[ "$exec_line" =~ ^[-@:+!] ]]; do exec_line="${exec_line:1}"; done
    if [ -n "$exec_line" ]; then
        printf '%s\n' "$exec_line"
        return 0
    fi
    for candidate in /usr/libexec/bluetooth/bluetoothd /usr/lib/bluetooth/bluetoothd \
                     /usr/sbin/bluetoothd /usr/bin/bluetoothd; do
        if [ -x "$ROOT$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# Copie l'assistant et la fiche polkit dans des emplacements appartenant à
# root.
install_self() {
    local src
    src="$(self_path)"

    if [ ! -e "$ROOT$PARENT_MARK" ] &&
       { [ ! -d "$ROOT$LIBEXEC_PARENT" ] || [ -e "$ROOT$OLD_PARENT_MARK" ]; }; then
        # Dossier parent créé par nous (ou par l'ancien nom) : noté pour que
        # revert le retire.
        write_file "$PARENT_MARK" 0644 <<< "# $MARKER: $LIBEXEC_PARENT was created by $NAME-setup."
    fi

    if [ "$src" = "$(readlink -f "$ROOT$SELF_INSTALLED" 2>/dev/null || true)" ]; then
        say "inchangé : $SELF_INSTALLED (c'est l'assistant en cours)"
    elif [ -f "$ROOT$SELF_INSTALLED" ] && cmp -s "$src" "$ROOT$SELF_INSTALLED"; then
        say "inchangé : $SELF_INSTALLED"
    elif [ "$DRY" = 1 ]; then
        say "copierait : $src -> $SELF_INSTALLED (mode 0755)"
    else
        mkdir -p "$ROOT$LIBEXEC"
        install -m 0755 "$src" "$ROOT$SELF_INSTALLED"
        say "copié : $src -> $SELF_INSTALLED"
    fi

    write_file "$POLICY" 0644 < <(content_policy)
}

# La source de l'auxiliaire : uniquement à côté de l'assistant en cours, là
# où elle a la même provenance que lui :
#   <dossier>/landline-le-params          copie de root (/usr/local/libexec/
#                                         landline) ou copie vérifiée du script
#                                         que lance l'extension
#   <dossier>/engine/landline-le-params   installation locale
#                                         (~/.local/lib/landline/landline-setup)
#   <dossier>/../landline-le-params       moteur installé en un clic, quand
#                                         l'assistant est dans engine/system/
# Jamais dans le dossier personnel de l'utilisateur qui a demandé les droits
# (PKEXEC_UID, SUDO_UID) : la copie de root lancée par pkexec donnerait sinon
# cap_net_raw à un fichier que cet utilisateur peut changer à volonté.
# Racine factice : LANDLINE_LE_PARAMS_SRC d'abord (essais).
le_params_source() {
    local dir candidate
    local -a candidates=()
    if [ -n "$ROOT" ] && [ -n "${LANDLINE_LE_PARAMS_SRC:-}" ]; then
        candidates+=("$LANDLINE_LE_PARAMS_SRC")
    fi
    dir="$(dirname "$(self_path)")"
    candidates+=("$dir/$LE_HELPER_NAME" "$dir/engine/$LE_HELPER_NAME")
    if [ "$(basename "$dir")" = system ]; then
        candidates+=("$(dirname "$dir")/$LE_HELPER_NAME")
    fi
    for candidate in "${candidates[@]}"; do
        # Un exécutable ELF ordinaire, de taille raisonnable.
        [ -f "$candidate" ] && [ ! -L "$candidate" ] || continue
        [ "$(stat -c %s "$candidate" 2>/dev/null || echo 0)" -le "$LE_HELPER_MAX_BYTES" ] || continue
        [ "$(head -c 4 "$candidate" | od -An -tx1 | tr -d ' \n')" = 7f454c46 ] || continue
        printf '%s\n' "$candidate"
        return 0
    done
    return 1
}

# Pose l'auxiliaire et son droit. Jamais d'échec d'apply pour lui.
install_le_params() {
    local src tmp setcap_bin
    if ! src="$(le_params_source)"; then
        if le_params_ready; then
            say "auxiliaire déjà en place ; pas de nouvelle version à côté de l'assistant"
        else
            note "auxiliaire $LE_HELPER_NAME introuvable à côté de l'assistant : réglage laissé de côté, le lien marche sans"
        fi
        return 0
    fi
    if [ -f "$ROOT$LE_HELPER" ] && cmp -s "$src" "$ROOT$LE_HELPER" && le_params_ready; then
        say "inchangé : $LE_HELPER (cap_net_raw posé)"
        write_file "$LE_HELPER_MARK" 0644 <<< "# $MARKER: $LE_HELPER was installed by $NAME-setup."
        return 0
    fi
    setcap_bin="$(tool_path setcap /usr/sbin/setcap)"
    if [ -z "$ROOT" ] && [ ! -x "$setcap_bin" ]; then
        note "setcap introuvable (paquet libcap2-bin) : auxiliaire non posé, le lien marche sans"
        return 0
    fi
    CHANGED=1
    if [ "$DRY" = 1 ]; then
        say "copierait : $src -> $LE_HELPER (root, mode 0755)"
        say "exécuterait : setcap cap_net_raw+ep $LE_HELPER"
        return 0
    fi
    mkdir -p "$ROOT$LIBEXEC"
    # Copié sous un nom provisoire, le droit posé dessus, puis mis en place
    # d'un coup : jamais de fichier à moitié écrit ni de droit sur une copie
    # qui change encore.
    tmp="$LIBEXEC/.$LE_HELPER_NAME.new"
    if [ -n "$ROOT" ]; then
        install -m 0755 "$src" "$ROOT$tmp"
    else
        install -o root -g root -m 0755 "$src" "$tmp"
    fi
    if ! cmp -s "$src" "$ROOT$tmp"; then
        rm -f "$ROOT$tmp"
        note "la copie de l'auxiliaire diffère de sa source : non posé"
        return 0
    fi
    if ! sys_run setcap cap_net_raw+ep "$tmp"; then
        rm -f "$ROOT$tmp"
        note "setcap a échoué : auxiliaire non posé, le lien marche sans"
        return 0
    fi
    mv -f "$ROOT$tmp" "$ROOT$LE_HELPER"
    say "copié : $src -> $LE_HELPER"
    write_file "$LE_HELPER_MARK" 0644 <<< "# $MARKER: $LE_HELPER was installed by $NAME-setup."
    if le_params_ready; then
        say "auxiliaire en place avec cap_net_raw : le moteur demandera à l'iPhone une supervision de 6 s au prochain lien LE"
    else
        note "auxiliaire copié mais cap_net_raw ne se relit pas (système de fichiers sans attributs étendus ?) : le moteur ne s'en servira pas"
    fi
}

remove_le_params() {
    if [ ! -e "$ROOT$LE_HELPER_MARK" ]; then
        if [ -e "$ROOT$LE_HELPER" ]; then
            warn "$LE_HELPER n'a pas été posé par $NAME-setup : laissé en place"
        fi
        return 0
    fi
    CHANGED=1
    if [ "$DRY" = 1 ]; then
        say "retirerait : $LE_HELPER (et son droit cap_net_raw)"
    else
        rm -f "$ROOT$LE_HELPER" "$ROOT$LIBEXEC/.$LE_HELPER_NAME.new"
        say "retiré : $LE_HELPER (et son droit cap_net_raw)"
    fi
    remove_path "$LE_HELPER_MARK"
}

# ---------------------------------------------------------------------------
# apply
# ---------------------------------------------------------------------------

# Retire ce qu'une version précédente posait pour la classe d'appareil.
# Met CLASS_UNITS_CHANGED / CLASS_UDEV_CHANGED à 1 selon ce qui a bougé.
CLASS_UNITS_CHANGED=0
CLASS_UDEV_CHANGED=0
remove_legacy_class() {
    CLASS_UNITS_CHANGED=0
    CLASS_UDEV_CHANGED=0
    if [ -e "$ROOT$UNIT_CLASS" ] || [ -L "$ROOT$WANTS_CLASS" ]; then
        sys_run systemctl stop "$UNIT_CLASS_NAME" || true
    fi
    CHANGED=0
    remove_path "$WANTS_CLASS"
    remove_dir_if_empty "$(dirname "$WANTS_CLASS")"
    remove_path "$UNIT_CLASS" marque
    CLASS_UNITS_CHANGED=$CHANGED
    CHANGED=0
    remove_path "$UDEV_RULE" marque
    CLASS_UDEV_CHANGED=$CHANGED
    remove_path "$CLASS_HELPER" marque
}

# Retire ce qu'une installation sous l'ancien nom a laissé, la classe mise à
# part (remove_legacy_class). Met OLD_UNITS_CHANGED à 1 si systemd doit relire.
OLD_UNITS_CHANGED=0
remove_old_install() {
    CHANGED=0
    remove_path "$OLD_WANTS_ERTM"
    remove_path "$OLD_UNIT_ERTM" marque
    remove_path "$OLD_DROPIN" marque
    OLD_UNITS_CHANGED=$CHANGED
    remove_path "$OLD_POLICY" marque
    remove_path "$OLD_SELF" marque
    remove_path "$OLD_PARENT_MARK"
    remove_dir_if_empty "$OLD_LIBEXEC"
}

do_apply() {
    require_root apply
    local need_restart=0 units_changed=0 udev_changed=0 ertm_changed=0
    local bluetoothd modprobe_bin

    modprobe_bin="$(tool_path modprobe /usr/sbin/modprobe)"

    say "== Assistant et fiche polkit"
    CHANGED=0
    install_self

    say "== Mode expérimental de bluetoothd"
    # L'ancien fichier d'appoint sera retiré plus bas : le réglage est jugé
    # sans lui, et le nôtre le remplace s'il le faut.
    if [ -f "$ROOT$OLD_DROPIN" ] && grep -q "$OLD_MARKER" "$ROOT$OLD_DROPIN" 2>/dev/null; then
        SKIP_OLD_DROPIN=1
    fi
    if ! experimental_required; then
        say "non requis avec BlueZ $(bluez_version) : rien à écrire, pas de redémarrage du Bluetooth"
    elif persistent_experimental && [ ! -f "$ROOT$DROPIN" ]; then
        say "déjà assuré par la configuration existante : rien à écrire"
        if running_without_experimental; then need_restart=1; fi
    else
        bluetoothd="$(bluetoothd_command)" || die "bluetooth.service et bluetoothd introuvables : BlueZ est-il installé ?"
        if has_experimental_flag "$bluetoothd"; then
            # Notre fichier existe mais un autre réglage donne déjà l'option.
            say "déjà assuré par la configuration existante"
            CHANGED=0
            remove_path "$DROPIN" marque
            [ "$CHANGED" = 1 ] && units_changed=1
        else
            CHANGED=0
            write_file "$DROPIN" 0644 < <(content_dropin "$bluetoothd")
            [ "$CHANGED" = 1 ] && units_changed=1
            if [ "$DRY" = 0 ] && ! persistent_experimental; then
                die "un autre fichier d'appoint de bluetooth.service redéfinit ExecStart après $DROPIN : --experimental ne serait pas pris en compte"
            fi
        fi
        if running_without_experimental; then need_restart=1; fi
    fi

    say "== Classe d'appareil"
    say "plus exigée : l'ordinateur garde sa classe d'origine"
    remove_legacy_class
    [ "$CLASS_UNITS_CHANGED" = 1 ] && units_changed=1
    udev_changed=$CLASS_UDEV_CHANGED

    say "== ERTM L2CAP"
    CHANGED=0
    write_file "$UNIT_ERTM" 0644 < <(content_unit_ertm "$modprobe_bin")
    make_link "$UNIT_ERTM" "$WANTS_ERTM"
    if [ "$CHANGED" = 1 ]; then units_changed=1; ertm_changed=1; fi

    say "== Tolérance du lien LE (souhaitée, non bloquante)"
    install_le_params

    say "== Installation sous l'ancien nom ($OLD_NAME)"
    remove_old_install
    [ "$OLD_UNITS_CHANGED" = 1 ] && units_changed=1

    say "== Activation"
    if [ "$units_changed" = 1 ]; then
        sys_run systemctl daemon-reload || warn "systemctl daemon-reload a échoué"
    fi
    if [ "$udev_changed" = 1 ]; then
        sys_run udevadm control --reload || warn "rechargement des règles udev refusé"
    fi

    if ! current_ertm || [ "$ertm_changed" = 1 ]; then
        sys_run systemctl restart "$UNIT_ERTM_NAME" || warn "$UNIT_ERTM_NAME n'a pas démarré"
        if [ "$DRY" = 0 ] && ! current_ertm; then
            write_sysfs "$ERTM_PARAM" N
        fi
    else
        say "ERTM déjà actif"
    fi

    if [ "$need_restart" = 1 ]; then
        say "REDÉMARRAGE DU BLUETOOTH : nécessaire pour le mode expérimental. Clavier, souris et casques Bluetooth sont coupés quelques secondes."
        sys_run systemctl restart bluetooth.service || warn "bluetooth.service n'a pas redémarré"
    else
        say "pas de redémarrage du Bluetooth : rien à changer dans le bluetoothd en service"
    fi

    say "== État"
    status_json
    [ "$WARNINGS" -eq 0 ] || exit 2
}

# ---------------------------------------------------------------------------
# revert
# ---------------------------------------------------------------------------

do_revert() {
    require_root revert
    local dropin_removed=0 dictated was_experimental=0 ertm_was_ours=0 units_changed=0

    if [ -e "$ROOT$UNIT_ERTM" ] || [ -L "$ROOT$WANTS_ERTM" ]; then ertm_was_ours=1; fi
    if [ -e "$ROOT$OLD_UNIT_ERTM" ] || [ -L "$ROOT$OLD_WANTS_ERTM" ]; then ertm_was_ours=1; fi

    if [ -n "$(running_bluetoothd_cmdline)" ] && has_experimental_flag "$(running_bluetoothd_cmdline)"; then
        was_experimental=1
    fi

    say "== Unités et règle"
    # La classe d'appareil n'est plus posée : seuls les restes d'une version
    # précédente sont retirés.
    remove_legacy_class
    units_changed=$CLASS_UNITS_CHANGED
    if [ -e "$ROOT$UNIT_ERTM" ]; then
        sys_run systemctl stop "$UNIT_ERTM_NAME" || true
    fi
    CHANGED=0
    remove_path "$WANTS_ERTM"
    remove_path "$OLD_WANTS_ERTM"
    remove_dir_if_empty "$(dirname "$WANTS_ERTM")"
    remove_path "$UNIT_ERTM" marque
    remove_path "$OLD_UNIT_ERTM" marque
    [ "$CHANGED" = 1 ] && units_changed=1
    if [ "$CLASS_UDEV_CHANGED" = 1 ]; then
        sys_run udevadm control --reload || warn "rechargement des règles udev refusé"
    fi

    say "== Mode expérimental de bluetoothd"
    CHANGED=0
    remove_path "$DROPIN" marque
    remove_path "$OLD_DROPIN" marque
    dropin_removed=$CHANGED
    remove_dir_if_empty "$DROPIN_DIR"
    if [ "$units_changed" = 1 ] || [ "$dropin_removed" = 1 ]; then
        sys_run systemctl daemon-reload || warn "systemctl daemon-reload a échoué"
    fi

    if [ "$dropin_removed" = 1 ] && [ "$was_experimental" = 1 ] && ! has_experimental_flag "$(effective_execstart sans-nous)" \
        && ! main_conf_experimental; then
        say "REDÉMARRAGE DU BLUETOOTH : nécessaire pour quitter le mode expérimental. Clavier, souris et casques Bluetooth sont coupés quelques secondes."
        sys_run systemctl restart bluetooth.service || warn "bluetooth.service n'a pas redémarré"
    else
        say "pas de redémarrage du Bluetooth : rien à changer dans le bluetoothd en service"
    fi

    say "== ERTM L2CAP"
    dictated="$(dictated_ertm)"
    if [ "$ertm_was_ours" = 0 ]; then
        say "notre unité n'était pas installée : rien à annuler"
    elif [ -n "$dictated" ]; then
        say "valeur imposée par la configuration du système : disable_ertm=$dictated"
        write_sysfs "$ERTM_PARAM" "$dictated"
    else
        say "aucune configuration ne fixe disable_ertm : valeur laissée telle quelle"
    fi

    say "== Tolérance du lien LE"
    remove_le_params

    say "== Assistant et fiche polkit"
    remove_path "$POLICY" marque
    remove_path "$SELF_INSTALLED" marque
    remove_path "$OLD_POLICY" marque
    remove_path "$OLD_SELF" marque
    if [ -e "$ROOT$PARENT_MARK" ] || [ -e "$ROOT$OLD_PARENT_MARK" ]; then
        remove_path "$PARENT_MARK"
        remove_path "$OLD_PARENT_MARK"
        remove_dir_if_empty "$LIBEXEC"
        remove_dir_if_empty "$OLD_LIBEXEC"
        remove_dir_if_empty "$LIBEXEC_PARENT"
    else
        remove_dir_if_empty "$LIBEXEC"
        remove_dir_if_empty "$OLD_LIBEXEC"
    fi

    say "== État"
    status_json
    [ "$WARNINGS" -eq 0 ] || exit 2
}

usage() {
    sed -n '6,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
    local action="${1:-}"
    [ $# -gt 0 ] && shift
    local arg
    for arg in "$@"; do
        case "$arg" in
            --dry-run) DRY=1 ;;
            *) usage >&2; exit 64 ;;
        esac
    done

    case "$action" in
        status)
            [ "$DRY" = 0 ] || { usage >&2; exit 64; }
            status_json
            ;;
        apply)   do_apply ;;
        revert)  do_revert ;;
        version) say "$VERSION" ;;
        -h|--help|help) usage ;;
        *) usage >&2; exit 64 ;;
    esac
}

# Tout le script est lu avant d'être exécuté : « revert » peut retirer sa
# propre copie sans dommage.
main "$@"
exit 0
